      },
      "source": [
        "def cart_pole_animation(history):\n",
        "    fig = plt.figure(figsize=(8, 4))\n",
        "    ax = fig.add_subplot(111, autoscale_on=False, xlim=(-2.4, 2.4), ylim=(-1.0, 1.5))\n",
        "    ax.set_aspect('equal')\n",
        "    ax.grid()\n",
        "\n",
        "    line, = ax.plot([], [], 'o-', lw=2)  # For the pole\n",
        "    cart_rect = plt.Rectangle([0, 0], 0.4, 0.2, fc='blue')  # For the cart\n",
        "    ax.add_patch(cart_rect)\n",
        "\n",
        "    time_text = ax.text(0.02, 0.95, '', transform=ax.transAxes)\n",
        "\n",
        "    def init():\n",
        "        line.set_data([], [])\n",
        "        cart_rect.set_xy([-0.2, 0]) # Initial cart position\n",
        "        time_text.set_text('')\n",
        "        return line, cart_rect, time_text\n",
        "\n",
        "    def animate(i):\n",
        "        x = history[i, 0]  # Cart position\n",
        "        theta = history[i, 2]  # Pole angle\n",
        "\n",
        "        # Cart position\n",
        "        cart_x = x - 0.2  # Adjust for rectangle origin\n",
        "        cart_y = 0.0\n",
        "        cart_rect.set_xy([cart_x, cart_y])\n",
        "\n",
        "        # Pole position\n",
        "        pole_x = [x, x + LENGTH * 2 * np.sin(theta)]\n",
        "        pole_y = [0.1, 0.1 + LENGTH * 2 * np.cos(theta)] # Pole starts slightly above cart\n",
        "        line.set_data(pole_x, pole_y)\n",
        "\n",
        "        time_text.set_text(f'Time: {i * env.timestep:.2f}s')\n",
        "        return line, cart_rect, time_text\n",
        "\n",
        "    ani = animation.FuncAnimation(fig, animate, frames=len(history),\n",
        "                                  interval=env.timestep * 1000, blit=True, init_func=init)\n",
        "\n",
        "    plt.close(fig) # Prevent static plot from showing\n",
        "    return HTML(ani.to_jshtml())"
      ],
      "execution_count": null,
      "outputs": []
    },
   
