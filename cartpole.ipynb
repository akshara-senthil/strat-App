      "source": [
        "# Create a CartPole environment instance\n",
        "env = CartPole()\n",
        "\n",
        "# Instantiate the PID controller\n",
        "# These are initial tuning parameters; they may need adjustment for optimal performance.\n",
        "# Kp: Proportional gain (responds to current error)\n",
        "# Ki: Integral gain (responds to accumulated error)\n",
        "# Kd: Derivative gain (responds to rate of change of error)\n",
        "# setpoint: Desired pole angle (0.0 for upright)\n",
        "# output_limits: Limits the force applied by the controller (e.g., -FORCE_MAGNITUDE to FORCE_MAGNITUDE)\n",
        "# integral_limits: Limits the integral term to prevent windup\n",
        "\n",
        "# Note: dt is env.timestep\n",
        "\n",
        "# Initial PID parameters - these will likely need tuning.\n",
        "# A common strategy is to start with Kp, then add Kd, then Ki.\n",
        "# For CartPole, often only P and D are sufficient for basic balancing.\n",
        "pid_controller = PIDController(\n",
        "    Kp=100.0,  # Proportional gain: strong response to angle error\n",
        "    Ki=0.1,    # Integral gain: helps reduce steady-state error\n",
        "    Kd=0,   # Derivative gain: dampens oscillations and anticipates changes\n",
        "    setpoint=0.0, # Desired pole angle (upright)\n",
        "    output_limits=(-FORCE_MAGNITUDE, FORCE_MAGNITUDE), # Limit output to max force\n",
        "    integral_limits=(-10.0, 10.0) # Limit integral term\n",
        ")\n",
        "\n",
        "\n",
        "# Reset the environment to get an initial state\n",
        "initial_state = env.reset()\n",
        "\n",
        "# Simulate for 100 steps and store the state history\n",
        "history = [initial_state]\n",
        "num_steps = 100\n",
        "\n",
        "for _ in range(num_steps):\n",
        "    # Get the current pole angle\n",
        "    current_theta = env.state[2]\n",
        "\n",
        "    # Use the PID controller to determine the control output (force)\n",
        "    # The controller's output will be a 'force' value within the output_limits\n",
        "    control_output = pid_controller.update(current_theta, env.timestep)\n",
        "\n",
        "    # Convert the continuous control output from PID to a discrete action for the CartPole environment\n",
        "    # If control_output is positive, push right (action = 1)\n",
        "    # If control_output is negative, push left (action = 0)\n",
        "    if control_output > 0:\n",
        "        action = 1  # Push right\n",
        "    else:\n",
        "        action = 0  # Push left\n",
        "\n",
        "    next_state = env.step(action)\n",
        "    history.append(next_state)\n",
        "\n",
        "history = np.array(history)\n",
        "\n",
        "print(f\"Simulation completed for {num_steps} steps.\")\n",
        "print(f\"Shape of history data: {history.shape}\")\n",
        "print(\"First 5 states:\\n\", history[:5])\n"
      ],
      "execution_count": null,
