        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "from matplotlib import animation\n",
        "from IPython.display import HTML\n",
        "\n",
        "# Define constants for the Cart-Pole system\n",
        "GRAVITY = 9.8  # acceleration due to gravity, in m/s^2\n",
        "MASS_CART = 1.0  # mass of the cart, in kg\n",
        "MASS_POLE = 0.1  # mass of the pole, in kg\n",
        "LENGTH = 0.5  # half-length of the pole, in m (total length is 1.0m)\n",
        "FORCE_MAGNITUDE = 10.0  # magnitude of the force applied to the cart, in N\n",
        "\n",
        "# Derived constants\n",
        "TOTAL_MASS = (MASS_CART + MASS_POLE)\n",
        "POLE_MASSXLENGTH = (MASS_POLE * LENGTH)\n",
        "\n",
        "\n",
        "class CartPole:\n",
        "    def __init__(self):\n",
        "        # State variables: [cart_position, cart_velocity, pole_angle, pole_angular_velocity]\n",
        "        # cart_position: x, in meters\n",
        "        # cart_velocity: x_dot, in m/s\n",
        "        # pole_angle: theta, in radians (0 is upright)\n",
        "        # pole_angular_velocity: theta_dot, in rad/s\n",
        "        self.state = np.array([0.0, 0.0, 0.0, 0.0]) # Initial state (all zeros)\n",
        "        self.timestep = 0.02 # Simulation time step (20 ms)\n",
        "\n",
        "    def step(self, action):\n",
        "        # Apply a force based on the action. Action 0: left, Action 1: right\n",
        "        force = FORCE_MAGNITUDE if action == 1 else -FORCE_MAGNITUDE\n",
        "\n",
        "        x, x_dot, theta, theta_dot = self.state\n",
        "\n",
        "        # Calculate intermediate values\n",
        "        cos_theta = np.cos(theta)\n",
        "        sin_theta = np.sin(theta)\n",
        "\n",
        "        temp = (force + POLE_MASSXLENGTH * theta_dot**2 * sin_theta) / TOTAL_MASS\n",
        "\n",
        "        # Equations of motion for the cart-pole system\n",
        "        theta_acc = (GRAVITY * sin_theta - cos_theta * temp) / \\\n",
        "                    (LENGTH * (4.0/3.0 - MASS_POLE * cos_theta**2 / TOTAL_MASS))\n",
        "\n",
        "        x_acc = temp - POLE_MASSXLENGTH * theta_acc * cos_theta / TOTAL_MASS\n",
        "\n",
        "        # Update state using Euler integration\n",
        "        x = x + self.timestep * x_dot\n",
        "        x_dot = x_dot + self.timestep * x_acc\n",
        "        theta = theta + self.timestep * theta_dot\n",
        "        theta_dot = theta_dot + self.timestep * theta_acc\n",
        "\n",
        "        self.state = np.array([x, x_dot, theta, theta_dot])\n",
        "\n",
        "        return self.state\n",
        "\n",
        "    def reset(self):\n",
        "        # Reset the state to a random small perturbation around upright\n",
        "        # This makes the problem more interesting than starting perfectly balanced.\n",
        "        self.state = np.random.uniform(low=-0.05, high=0.05, size=(4,))\n",
        "        return self.state"
      ],
