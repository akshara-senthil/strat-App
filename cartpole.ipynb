      "source": [
        "class PIDController:\n",
        "    def __init__(self, Kp, Ki, Kd, setpoint=0.0, output_limits=None, integral_limits=None):\n",
        "        self.Kp = Kp\n",
        "        self.Ki = Ki\n",
        "        self.Kd = Kd\n",
        "        self.setpoint = setpoint\n",
        "\n",
        "        self.prev_error = 0.0\n",
        "        self.integral = 0.0\n",
        "\n",
        "        # Optional: Output limits to prevent integral windup or excessively large control signals\n",
        "        self.output_limits = output_limits\n",
        "        self.integral_limits = integral_limits\n",
        "\n",
        "    def update(self, current_value, dt):\n",
        "        error = self.setpoint - current_value\n",
        "\n",
        "        # Proportional term\n",
        "        P_term = self.Kp * error\n",
        "\n",
        "        # Integral term\n",
        "        self.integral += error * dt\n",
        "        if self.integral_limits is not None:\n",
        "            self.integral = np.clip(self.integral, self.integral_limits[0], self.integral_limits[1])\n",
        "        I_term = self.Ki * self.integral\n",
        "\n",
        "        # Derivative term\n",
        "        derivative = (error - self.prev_error) / dt\n",
        "        D_term = self.Kd * derivative\n",
        "\n",
        "        output = P_term + I_term + D_term\n",
        "\n",
        "        if self.output_limits is not None:\n",
        "            output = np.clip(output, self.output_limits[0], self.output_limits[1])\n",
        "\n",
        "        self.prev_error = error\n",
        "\n",
        "        return output\n",
        "\n",
        "print(\"PIDController class defined.\")"
      ],
      "execution_count": null,
      "outputs": [
        {
          "output_type": "stream",
